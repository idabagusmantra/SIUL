# Kosongkan SIUL_API_URL untuk mode demonstrasi (tanpa model).
# Lokal : http://127.0.0.1:8000   |  Vercel: URL publik backend, mis. https://namamu-siul.hf.space
SIUL_API_URL=http://127.0.0.1:8000
# Opsional: kunci bersama (dikirim sebagai Bearer). Set juga SIUL_API_KEY di backend. TIDAK berlaku untuk unggah langsung.
SIUL_API_KEY=
# Opsional: izinkan akses dev dari perangkat lain di LAN, dipisah koma.
SIUL_DEV_ORIGINS=
# Khusus Vercel: browser mengunggah audio LANGSUNG ke backend (fungsi Vercel menolak body > 4,5 MB).
# Isi dengan URL publik backend dan set SIUL_CORS_ORIGINS di backend ke domain Vercel Anda. Kosongkan untuk lokal.
NEXT_PUBLIC_SIUL_DIRECT_URL=
